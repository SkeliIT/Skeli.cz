DB_URL=jdbc:mariadb://localhost:3306/skeliweb?useUnicode=true&characterEncoding=utf8mb4
DB_USER=Skeli
DB_PASS=change-me

# SMTP Configuration for sending emails
# When SMTP_HOST, SMTP_USERNAME and SMTP_PASSWORD are all set, new accounts must confirm
# their e-mail (link valid 48 h) before they can comment or vote. Without SMTP nobody is asked to.
SMTP_HOST=mail.vitexsoftware.cz
SMTP_PORT=587
SMTP_USERNAME=robot@skeli.cz
SMTP_PASSWORD=change-me
SMTP_FROM=robot@skeli.cz
SMTP_FROM_NAME=Skeli Robot
SMTP_ENCRYPTION=tls

# Apple Music API (MusicKit) — see https://developer.apple.com/documentation/applemusicapi
# Obtain from Apple Developer: Certificates, Identifiers & Profiles -> Keys -> MusicKit
APPLE_MUSIC_TEAM_ID=XXXXXXXXXX
APPLE_MUSIC_KEY_ID=YYYYYYYYYY
# Paste contents of the .p8 file (newlines replaced with \n or as-is in a multi-line env)
APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGHAgEA...\n-----END PRIVATE KEY-----
# Music User Token — required for lyrics; generate via MusicKit JS in a browser with Apple Music subscription
APPLE_MUSIC_USER_TOKEN=
# Apple Music storefront (country code, e.g. cz, us, gb)
APPLE_MUSIC_STOREFRONT=cz
# Artist name used in catalog search queries
APPLE_MUSIC_ARTIST=Skeli
# Apple Music Artist ID — find it on music.apple.com in the artist URL (e.g. /artist/skeli/1234567890)
# When set, sync uses the full artist catalog instead of per-song text search (more accurate)
APPLE_MUSIC_ARTIST_ID=

# Public base URL used in e-mail links (password reset). Never derived from the Host header.
APP_BASE_URL=https://www.skeli.cz

# Shared secret for POST /api/social-posts (send as X-Social-Token header). Required - without it posting is disabled.
SOCIAL_TOKEN=

# YouTube Data API (used by /admin/sync)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Directory for user uploads outside the WAR (survives redeploys). Avatars go to $UPLOAD_DIR/avatars.
UPLOAD_DIR=

# Instagram posts on the Aktuality page (Instagram API with Instagram Login, read-only).
# Generate at developers.facebook.com > app > Instagram use case > Generate access tokens.
# Only needed for the first start: the app refreshes it weekly and keeps the new one in the DB.
INSTAGRAM_ACCESS_TOKEN=
