<%@ page import="com.github.skeliit.Db" %>
<%-- i18n loader: exposes the current language's translations as local variable 't' and request attribute 't' --%>
<%
  String lang = request.getParameter("lang");
  if (com.github.skeliit.I18n.isSupported(lang)) {
    session.setAttribute("lang", lang);
  }
  String cur = com.github.skeliit.I18n.safeLang(session.getAttribute("lang"));
  java.util.Properties t = com.github.skeliit.I18n.bundle(application, cur);
  request.setAttribute("t", t);
%>
