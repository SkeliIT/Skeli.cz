<%-- Live password helper under a new-password field (register, reset, settings).
     The form needs inputs with data-pw="new" and data-pw="confirm"; js/password-helper.js ticks
     the rules while typing. Rule codes match WebUtils.passwordProblems(). --%>
<div class="pw-helper" data-pw-helper>
  <div class="pw-meter" data-pw-meter hidden>
    <span class="pw-meter-label"><%= t.getProperty("pw.strength") %> <strong data-pw-level
      data-l1="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.strength.1")) %>"
      data-l2="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.strength.2")) %>"
      data-l3="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.strength.3")) %>"
      data-l4="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.strength.4")) %>"></strong></span>
    <span class="pw-meter-bar"><span></span></span>
  </div>
  <ul class="pw-rules" data-pw-rules aria-live="polite">
    <li data-rule="length"><%= t.getProperty("pw.rule.length") %></li>
    <li data-rule="lower"><%= t.getProperty("pw.rule.lower") %></li>
    <li data-rule="upper"><%= t.getProperty("pw.rule.upper") %></li>
    <li data-rule="digit"><%= t.getProperty("pw.rule.digit") %></li>
    <li data-rule="special"><%= t.getProperty("pw.rule.special") %></li>
    <li data-rule="invalid" data-only-bad hidden
        data-text="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.rule.invalid")) %>"
        data-space="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.space")) %>"></li>
    <li data-rule="long" data-only-bad hidden><%= t.getProperty("pw.rule.long") %></li>
    <li data-rule="common" data-only-bad data-hint hidden><%= t.getProperty("pw.rule.common") %></li>
  </ul>
  <p class="pw-match" data-pw-match hidden aria-live="polite"
     data-ok="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.match.ok")) %>"
     data-bad="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("pw.match.bad")) %>"></p>
</div>
