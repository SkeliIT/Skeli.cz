<%-- Tělo chatu: /zpravy (WEB-INF/views/chat.jsp) i malé okno v liště (chat-embed.jsp). Vkládaná šablona se nečte jako UTF-8: žádné české znaky přímo ve výstupu. --%>
<%
  @SuppressWarnings("unchecked")
  java.util.List<ChatConversation> chatList = (java.util.List<ChatConversation>) request.getAttribute("chatList");
  if (chatList == null) chatList = java.util.List.of();
  String chatWith = (String) request.getAttribute("chatWith");
  com.github.skeliit.model.ChatPrefs chatPrefs = (com.github.skeliit.model.ChatPrefs) request.getAttribute("chatPrefs");
  if (chatPrefs == null) chatPrefs = new com.github.skeliit.model.ChatPrefs();
  boolean chatEmbed = Boolean.TRUE.equals(request.getAttribute("chatEmbed"));   // malé okno v liště: odkazy zůstávají v něm
  String chatTop = chatEmbed ? " target=\"_top\"" : "";
%>
<main class="chat-page<%= chatWith != null ? " in-room" : "" %>" data-chat-theme="<%= chatPrefs.theme %>" data-chat-font="<%= chatPrefs.font %>" data-chat-size="<%= chatPrefs.size %>" data-csrf="<%= com.github.skeliit.filter.CsrfFilter.token(session) %>">
  <%-- nastavení: stav, barvy, písmo, velikost; ukládá se hned při změně (js/chat.js) --%>
  <dialog class="chat-settings" aria-label="<%= t.getProperty("chat.settings") %>">
    <form method="dialog" class="chat-settings-head">
      <h2><i class="fa-solid fa-gear" aria-hidden="true"></i> <%= t.getProperty("chat.settings") %></h2>
      <button type="submit" class="chat-settings-close" aria-label="<%= t.getProperty("chat.settings.close") %>"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </form>
    <fieldset>
      <legend><%= t.getProperty("chat.status") %></legend>
      <div class="chat-opts">
        <% for (String v : com.github.skeliit.model.ChatPrefs.STATUSES) { %>
        <label class="chat-opt"><input type="radio" name="status" value="<%= v %>"<%= v.equals(chatPrefs.status) ? " checked" : "" %>> <span class="chat-state-dot s-<%= v %>" aria-hidden="true"></span> <%= t.getProperty("chat.status." + v) %></label>
        <% } %>
      </div>
      <p class="chat-settings-note"><%= t.getProperty("chat.status.note") %></p>
      <label class="chat-opt chat-receipts"><input type="checkbox" name="receipts" value="1"<%= chatPrefs.receipts ? " checked" : "" %>> <i class="fa-solid fa-eye" aria-hidden="true"></i> <span><%= t.getProperty("chat.receipts") %></span></label>
    </fieldset>
    <%@ include file="/includes/sound-prefs.jspf" %>
    <fieldset>
      <legend><%= t.getProperty("chat.theme") %></legend>
      <div class="chat-opts chat-swatches">
        <% for (String v : com.github.skeliit.model.ChatPrefs.THEMES) { %>
        <label class="chat-swatch" data-chat-theme="<%= v %>" title="<%= t.getProperty("chat.theme." + v) %>"><input type="radio" name="theme" value="<%= v %>"<%= v.equals(chatPrefs.theme) ? " checked" : "" %>> <span class="chat-swatch-bubble" aria-hidden="true">&#x1F525;&#x1F602;</span> <span class="chat-swatch-name"><%= t.getProperty("chat.theme." + v) %></span></label>
        <% } %>
      </div>
    </fieldset>
    <fieldset>
      <legend><%= t.getProperty("chat.font") %></legend>
      <div class="chat-opts">
        <% for (String v : com.github.skeliit.model.ChatPrefs.FONTS) { %>
        <label class="chat-opt" data-chat-font="<%= v %>"><input type="radio" name="font" value="<%= v %>"<%= v.equals(chatPrefs.font) ? " checked" : "" %>> <span class="chat-font-sample"><%= t.getProperty("chat.font." + v) %></span></label>
        <% } %>
      </div>
    </fieldset>
    <fieldset>
      <legend><%= t.getProperty("chat.size") %></legend>
      <div class="chat-opts">
        <% for (String v : com.github.skeliit.model.ChatPrefs.SIZES) { %>
        <label class="chat-opt"><input type="radio" name="size" value="<%= v %>"<%= v.equals(chatPrefs.size) ? " checked" : "" %>> <%= t.getProperty("chat.size." + v) %></label>
        <% } %>
      </div>
    </fieldset>
  </dialog>
  <section class="chat-list" aria-label="<%= t.getProperty("chat.title") %>">
    <div class="chat-title-row">
      <h1 class="chat-title"><i class="fa-solid fa-comments" aria-hidden="true"></i> <%= t.getProperty("chat.title") %></h1>
      <button type="button" class="chat-gear" title="<%= t.getProperty("chat.settings") %>" aria-label="<%= t.getProperty("chat.settings") %>"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
    </div>
    <% if (chatList.isEmpty()) { %>
    <p class="acct-empty"><%= t.getProperty("chat.none") %></p>
    <a class="btn btn-primary"<%= chatTop %> href="/uzivatel.jsp#pratele"><%= t.getProperty("chat.findFriends") %></a>
    <% } %>
    <ul class="chat-people">
      <% for (ChatConversation v : chatList) { %>
      <li><a class="chat-person<%= v.username.equals(chatWith) ? " active" : "" %>" href="/zpravy?<%= chatEmbed ? "embed=1&amp;" : "" %>s=<%= java.net.URLEncoder.encode(v.username, "UTF-8") %>">
        <span class="chat-avatar">
          <img src="<%= WebUtils.escapeHtml(v.avatarUrl) %>" alt="" width="44" height="44" loading="lazy" referrerpolicy="no-referrer">
          <% if (v.state != null && !"offline".equals(v.state)) { %><span class="chat-state-dot s-<%= v.state %>" title="<%= t.getProperty("chat.status." + v.state) %>"></span><% } %>
        </span>
        <span class="chat-person-text">
          <b><%= WebUtils.escapeHtml(v.username) %></b>
          <small><%= v.lastBody == null ? t.getProperty("chat.write") : v.lastDeleted ? t.getProperty("chat.deleted") : (v.lastMine ? t.getProperty("chat.you") + " " : "") + WebUtils.escapeHtml(v.lastBody) %></small>
        </span>
        <% if (v.unread > 0) { %><span class="acct-count" aria-label="<%= t.getProperty("chat.unread") %>"><%= v.unread %></span><% } %>
      </a></li>
      <% } %>
    </ul>
    <p class="chat-privacy"><i class="fa-solid fa-lock" aria-hidden="true"></i> <%= t.getProperty("chat.privacy") %></p>
  </section>

  <% if (chatWith != null) { %>
  <section class="chat-room" data-with="<%= WebUtils.escapeHtml(chatWith) %>" data-csrf="<%= com.github.skeliit.filter.CsrfFilter.token(session) %>"
           data-t-delete-confirm="<%= WebUtils.escapeHtml(t.getProperty("chat.deleteConfirm")) %>" data-t-deleted="<%= WebUtils.escapeHtml(t.getProperty("chat.deleted")) %>"
           data-t-delete="<%= WebUtils.escapeHtml(t.getProperty("chat.delete")) %>" data-t-report="<%= WebUtils.escapeHtml(t.getProperty("chat.report")) %>"
           data-t-reported="<%= WebUtils.escapeHtml(t.getProperty("chat.reported")) %>" data-t-limit="<%= WebUtils.escapeHtml(t.getProperty("chat.limit")) %>"
           data-t-fail="<%= WebUtils.escapeHtml(t.getProperty("chat.fail")) %>" data-t-hide-confirm="<%= WebUtils.escapeHtml(t.getProperty("chat.hideConfirm")) %>"
           data-t-play="<%= WebUtils.escapeHtml(t.getProperty("chat.embed.play")) %>" data-t-open="<%= WebUtils.escapeHtml(t.getProperty("chat.embed.open")) %>"
           data-t-reply="<%= WebUtils.escapeHtml(t.getProperty("chat.reply")) %>" data-t-reply-to="<%= WebUtils.escapeHtml(t.getProperty("chat.replyTo")) %>" data-t-edit="<%= WebUtils.escapeHtml(t.getProperty("chat.edit")) %>"
           data-t-editing="<%= WebUtils.escapeHtml(t.getProperty("chat.editing")) %>" data-t-edited="<%= WebUtils.escapeHtml(t.getProperty("chat.edited")) %>" data-t-more="<%= WebUtils.escapeHtml(t.getProperty("chat.more")) %>"
           data-base="/zpravy<%= chatEmbed ? "?embed=1" : "" %>" data-t-seen="<%= WebUtils.escapeHtml(t.getProperty("chat.seen")) %>" data-t-mute="<%= WebUtils.escapeHtml(t.getProperty("chat.mute")) %>" data-t-unmute="<%= WebUtils.escapeHtml(t.getProperty("chat.unmute")) %>"
           aria-label="<%= WebUtils.escapeHtml(chatWith) %>">
    <header class="chat-head">
      <a class="chat-back" href="/zpravy<%= chatEmbed ? "?embed=1" : "" %>" aria-label="<%= t.getProperty("chat.back") %>"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
      <div class="chat-who-box">
        <a class="chat-who"<%= chatTop %> href="/hrac/<%= java.net.URLEncoder.encode(chatWith, "UTF-8").replace("+", "%20") %>"><%= WebUtils.escapeHtml(chatWith) %></a>
        <small class="chat-who-state" hidden data-t-online="<%= t.getProperty("chat.status.online") %>" data-t-busy="<%= t.getProperty("chat.status.busy") %>" data-t-dnd="<%= t.getProperty("chat.status.dnd") %>"></small>
      </div>
      <button type="button" class="chat-gear" title="<%= t.getProperty("chat.settings") %>" aria-label="<%= t.getProperty("chat.settings") %>"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
      <button type="button" class="chat-mute" aria-pressed="false" title="<%= t.getProperty("chat.mute") %>" aria-label="<%= t.getProperty("chat.mute") %>"><i class="fa-solid fa-bell" aria-hidden="true"></i></button>
      <button type="button" class="chat-hide" title="<%= t.getProperty("chat.hide") %>" aria-label="<%= t.getProperty("chat.hide") %>"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
    </header>
    <button type="button" class="chat-older" hidden><%= t.getProperty("chat.older") %></button>
    <ol class="chat-msgs" aria-live="polite"></ol>
    <p class="chat-closed" hidden><%= t.getProperty("chat.closed") %></p>
    <p class="chat-error form-alert" role="alert" hidden></p>
    <div class="chat-compose-bar" hidden><span></span><button type="button" aria-label="<%= t.getProperty("chat.settings.close") %>"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
    <form class="chat-form">
      <button type="button" class="chat-emoji-btn" aria-expanded="false" title="<%= t.getProperty("cmt.emoji") %>" aria-label="<%= t.getProperty("cmt.emoji") %>"><i class="fa-regular fa-face-smile" aria-hidden="true"></i></button>
      <div class="chat-emoji" hidden></div>
      <textarea name="body" rows="1" maxlength="1000" required aria-label="<%= t.getProperty("chat.placeholder") %>" placeholder="<%= t.getProperty("chat.placeholder") %>"></textarea>
      <button type="submit" class="btn-primary" aria-label="<%= t.getProperty("chat.send") %>" title="<%= t.getProperty("chat.send") %>"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
    </form>
    <template class="chat-report-tpl">
      <form class="chat-report-form">
        <label><%= t.getProperty("chat.report.why") %>
          <select name="reason">
            <option value="abuse"><%= t.getProperty("chat.report.abuse") %></option>
            <option value="spam"><%= t.getProperty("chat.report.spam") %></option>
            <option value="other"><%= t.getProperty("chat.report.other") %></option>
          </select>
        </label>
        <input name="note" maxlength="300" placeholder="<%= t.getProperty("player.report.note") %>" aria-label="<%= t.getProperty("player.report.note") %>">
        <button type="submit" class="btn-outline friend-btn"><%= t.getProperty("player.report.send") %></button>
      </form>
    </template>
  </section>
  <% } else { %>
  <section class="chat-pick"><p><i class="fa-solid fa-comments" aria-hidden="true"></i> <%= t.getProperty("chat.pick") %></p></section>
  <% } %>
  <script src="/js/chat.js?v=<%= assetVersion %>"></script>
</main>
