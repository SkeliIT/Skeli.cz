<%-- "Co říkáš na web?" in the home page's side column (web/site/FeedbackServlet, dao/FeedbackDao): thumbs up or down
     for the whole site and an optional message, one per signed-in user (sending again changes it). The messages the artist picks in /admin/feedback show
     as references in their own band (includes/feedback-refs.jspf). --%>
<%
  int[] fbCounts = {0, 0};
  com.github.skeliit.model.SiteFeedback fbMine = null;
  Object fbO = session.getAttribute("userId");   // (no pattern matching: the JSP compiler is older Java)
  Integer fbUser = fbO instanceof Integer ? (Integer) fbO : null;
  try {
    com.github.skeliit.dao.FeedbackDao fbDao = new com.github.skeliit.dao.FeedbackDao();
    fbCounts = fbDao.counts();
    if (fbUser != null) fbMine = fbDao.mine(fbUser);
  } catch (java.sql.SQLException fbErr) { /* the card shows without numbers */ }
  String fbState = request.getParameter("feedback");
%>
      <div class="card side-card feedback-card" id="feedback">
        <h3><i class="fa-solid fa-comment-dots"></i> <%= t.getProperty("home.feedback.title") %></h3>
        <p class="fb-counts" aria-label="<%= fbCounts[0] %> 👍, <%= fbCounts[1] %> 👎">
          <span class="fb-up"><i class="fa-solid fa-thumbs-up" aria-hidden="true"></i> <%= fbCounts[0] %></span>
          <span class="fb-down"><i class="fa-solid fa-thumbs-down" aria-hidden="true"></i> <%= fbCounts[1] %></span>
        </p>
        <% if ("thanks".equals(fbState)) { %><p class="fb-flash"><%= t.getProperty("home.feedback.thanks") %></p><% } %>
        <% if ("limit".equals(fbState)) { %><p class="fb-flash warn"><%= t.getProperty("home.feedback.limit") %></p><% } %>
        <% if (fbUser != null) { boolean fbUp = fbMine == null || fbMine.vote > 0; %>
        <p class="fb-lead"><%= t.getProperty("home.feedback.lead") %></p>
        <form method="post" action="/feedback" class="fb-form">
          <input type="hidden" name="csrf" value="<%= request.getAttribute("csrf") %>">
          <div class="hp-field" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
          <div class="fb-votes" role="radiogroup" aria-label="<%= t.getProperty("home.feedback.title") %>">
            <label class="fb-vote up"><input type="radio" name="vote" value="up"<%= fbMine != null && fbUp ? " checked" : "" %> required><i class="fa-solid fa-thumbs-up" aria-hidden="true"></i> <%= t.getProperty("home.feedback.like") %></label>
            <label class="fb-vote down"><input type="radio" name="vote" value="down"<%= fbMine != null && !fbUp ? " checked" : "" %>><i class="fa-solid fa-thumbs-down" aria-hidden="true"></i> <%= t.getProperty("home.feedback.dislike") %></label>
          </div>
          <% if (fbMine != null && fbMine.message == null) { %><p class="fb-nudge"><i class="fa-solid fa-pen" aria-hidden="true"></i> <%= t.getProperty("home.feedback.nudge") %></p><% } %>
          <textarea name="message" maxlength="500" rows="3" placeholder="<%= t.getProperty(fbMine == null ? "home.feedback.placeholder" : fbUp ? "home.feedback.placeholder.up" : "home.feedback.placeholder.down") %>" data-up="<%= t.getProperty("home.feedback.placeholder.up") %>" data-down="<%= t.getProperty("home.feedback.placeholder.down") %>"><%= fbMine != null && fbMine.message != null ? com.github.skeliit.WebUtils.escapeHtml(fbMine.message) : "" %></textarea>
          <button type="submit"><%= t.getProperty(fbMine != null ? "home.feedback.update" : "home.feedback.send") %></button>
          <p class="fb-note"><%= t.getProperty("home.feedback.note") %></p>
        </form>
        <script>
          // a thumb invites a message: the box lights up, takes the cursor and asks according to the thumb
          (function () {
            var f = document.querySelector("#feedback .fb-form"); if (!f || f.dataset.on) return; f.dataset.on = "1";
            var box = f.querySelector("textarea");
            f.addEventListener("change", function (e) {
              if (e.target.name !== "vote") return;
              box.placeholder = box.getAttribute("data-" + e.target.value);
              box.classList.remove("fb-invite"); void box.offsetWidth; box.classList.add("fb-invite");
              if (!box.value) box.focus({ preventScroll: true });
            });
          })();
        </script>
        <% } else { %>
        <p class="fb-lead"><%= t.getProperty("home.feedback.login") %></p>
        <a class="btn btn-primary fb-login" href="/login.jsp?next=%2Fabout.jsp%23feedback"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> <%= t.getProperty("auth.submit.login") %></a>
        <% } %>
      </div>
