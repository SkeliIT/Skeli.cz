<%-- Full / Soft / Off for the water and fire round a clip (js/clip-fx.js), as a small drop-down that
     sits outside the effect: in the bar above the lyrics on a song page, next to the heading on Music. --%>
<details class="clip-fx-switch" hidden>
  <summary title="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("clipfx.label")) %>">
    <i class="fa-solid fa-fire-flame-curved" aria-hidden="true"></i>
    <span class="clip-fx-label"><%= t.getProperty("clipfx.label") %>:</span>
    <span class="clip-fx-current" data-on="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("clipfx.on")) %>"
          data-soft="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("clipfx.soft")) %>"
          data-off="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("clipfx.off")) %>"><%= t.getProperty("clipfx.on") %></span>
    <i class="fa-solid fa-chevron-down clip-fx-caret" aria-hidden="true"></i>
  </summary>
  <div class="clip-fx-options" role="group" aria-label="<%= com.github.skeliit.WebUtils.escapeHtml(t.getProperty("clipfx.label")) %>">
    <button type="button" data-mode="on" aria-pressed="true"><%= t.getProperty("clipfx.on") %></button>
    <button type="button" data-mode="soft" aria-pressed="false"><%= t.getProperty("clipfx.soft") %></button>
    <button type="button" data-mode="off" aria-pressed="false"><%= t.getProperty("clipfx.off") %></button>
  </div>
</details>
