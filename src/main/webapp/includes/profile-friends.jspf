<%-- Můj profil → Přátelé: žádosti, přátelé, hledání a zablokovaní. Před vložením nastavit: List<Friend> frFriends, frIn, frOut, frBlocked, frFound; Map frRel (vztah k nalezeným podle id); String frQuery.
     Vkládané šablony se nečtou jako UTF-8: žádné české znaky přímo ve výstupu, texty jsou v překladech. --%>
<%@ page import="com.github.skeliit.model.Friend" %>
<%! /* fotka a jméno; odkaz jen na veřejný profil, jinak by vedl na 404 */
    private static String frWho(Friend f) throws java.io.UnsupportedEncodingException {
        String in = "<img src=\"" + WebUtils.escapeHtml(f.avatarUrl) + "\" alt=\"\" width=\"44\" height=\"44\" loading=\"lazy\" referrerpolicy=\"no-referrer\"><span>" + WebUtils.escapeHtml(f.username) + "</span>";
        if (!f.pub) return "<span class=\"friend-who\">" + in + "</span>";
        return "<a class=\"friend-who\" href=\"/hrac/" + java.net.URLEncoder.encode(f.username, "UTF-8").replace("+", "%20") + "\">" + in + "</a>";
    } %>
<section class="pt pt-panel">
  <div class="pt-in">
    <header class="acct-card-head">
      <h3><i class="fa-solid fa-user-group" aria-hidden="true"></i> <%= t.getProperty("profile.tab.friends") %></h3>
      <p><%= t.getProperty("friends.lead") %></p>
    </header>
    <% String frMsg = request.getParameter("friend"); if (frMsg != null && java.util.Set.of("fail", "verify", "limit", "closed").contains(frMsg)) { %><p class="form-alert" role="alert"><%= t.getProperty("friends.msg." + frMsg) %></p><% } %>

    <%-- Hledat přátele: otevřené po hledání, při návratu ze seznamu a u člověka, který ještě nikoho nemá --%>
    <% String frFindBack = "/uzivatel.jsp?najit=1" + (frPage > 0 ? "&np=" + frPage : "");
       boolean frFindOpen = request.getParameter("najit") != null || (frQuery != null && !frQuery.isBlank()) || (frFriends.isEmpty() && frIn.isEmpty()); %>
    <details class="friend-find"<%= frFindOpen ? " open" : "" %>>
    <summary class="btn-primary"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> <span><%= t.getProperty("friends.find") %></span> <i class="fa-solid fa-chevron-down friend-find-chev" aria-hidden="true"></i></summary>
    <div class="friend-find-body">
    <form class="friend-search" method="get" action="/uzivatel.jsp#pratele" role="search" data-suggest
          data-csrf="<%= com.github.skeliit.filter.CsrfFilter.token(session) %>" data-t-add="<%= WebUtils.escapeHtml(t.getProperty("friends.add")) %>" data-t-accept="<%= WebUtils.escapeHtml(t.getProperty("friends.accept")) %>"
          data-t-sent="<%= WebUtils.escapeHtml(t.getProperty("friends.state.sent")) %>" data-t-friends="<%= WebUtils.escapeHtml(t.getProperty("friends.state.friends")) %>"
          data-t-none="<%= WebUtils.escapeHtml(t.getProperty("friends.notFound")) %>" data-t-fail="<%= WebUtils.escapeHtml(t.getProperty("friends.msg.fail")) %>"
          data-t-verify="<%= WebUtils.escapeHtml(t.getProperty("friends.msg.verify")) %>" data-t-limit="<%= WebUtils.escapeHtml(t.getProperty("friends.msg.limit")) %>" data-t-closed="<%= WebUtils.escapeHtml(t.getProperty("friends.msg.closed")) %>">
      <input type="search" name="fq" minlength="2" maxlength="50" value="<%= WebUtils.escapeHtml(frQuery) %>" placeholder="<%= t.getProperty("friends.search") %>" aria-label="<%= t.getProperty("friends.search") %>">
      <button type="submit" class="btn-primary" aria-label="<%= t.getProperty("friends.search") %>"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
      <ul class="friend-suggest" id="friendSuggest" role="listbox" aria-label="<%= t.getProperty("friends.search") %>" hidden></ul>
      <p class="friend-suggest-status form-alert" role="alert" hidden></p>
    </form>
    <script src="/js/friend-suggest.js?v=<%= assetVersion %>"></script>
    <% if (frQuery != null && !frQuery.isBlank()) { %>
    <h4 class="friend-head"><%= t.getProperty("friends.found") %></h4>
    <% if (frFound.isEmpty()) { %><p class="acct-empty"><%= t.getProperty("friends.notFound") %></p><% } %>
    <ul class="friend-list">
      <% for (Friend f : frFound) { %>
      <% com.github.skeliit.dao.FriendDao.Rel foundRel = frRel.get(f.id); %>
      <li class="friend-row">
        <%= frWho(f) %>
        <% if (foundRel == com.github.skeliit.dao.FriendDao.Rel.NONE) { %><form method="post" action="/profile/friends"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="request"><button type="submit" class="btn-primary friend-btn"><%= t.getProperty("friends.add") %></button></form>
        <% } else if (foundRel == com.github.skeliit.dao.FriendDao.Rel.RECEIVED) { %><form method="post" action="/profile/friends"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="accept"><button type="submit" class="btn-primary friend-btn"><%= t.getProperty("friends.accept") %></button></form>
        <% } else if (foundRel == com.github.skeliit.dao.FriendDao.Rel.SENT) { %><span class="player-state"><%= t.getProperty("friends.state.sent") %></span>
        <% } else if (foundRel == com.github.skeliit.dao.FriendDao.Rel.FRIENDS) { %><span class="player-state on"><%= t.getProperty("friends.state.friends") %></span><% } %>
      </li>
      <% } %>
    </ul>
    <% } %>

    <%-- nejdřív to, co se týká mě: ukazuju se, nebo ne, a jedním klikem se to změní --%>
    <form class="people-me<%= frShown ? " on" : "" %>" method="post" action="/profile/friends">
      <input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="back" value="<%= WebUtils.escapeHtml(frFindBack) %>">
      <input type="hidden" name="action" value="<%= frShown ? "hide" : "show" %>">
      <p><i class="fa-solid <%= frShown ? "fa-eye" : "fa-eye-slash" %>" aria-hidden="true"></i> <%= t.getProperty(frShown ? "people.me.in" : "people.me.out") %></p>
      <button type="submit" class="<%= frShown ? "btn-outline" : "btn-primary" %> friend-btn"><%= t.getProperty(frShown ? "people.me.leave" : "people.me.join") %></button>
    </form>

    <h4 class="friend-head"><%= t.getProperty("people.title") %></h4>
    <p class="people-lead"><%= t.getProperty("people.lead") %></p>
    <% if (frPeople.isEmpty()) { %><p class="acct-empty"><%= t.getProperty("people.none") %></p><% } %>
    <ul class="people-grid">
      <% for (com.github.skeliit.model.DirectoryPerson p : frPeople) { String urlName = java.net.URLEncoder.encode(p.username, "UTF-8").replace("+", "%20"); %>
      <li class="people-card">
        <span class="people-av">
          <img src="<%= WebUtils.escapeHtml(p.avatarUrl) %>" alt="" width="64" height="64" loading="lazy" referrerpolicy="no-referrer">
          <% if (p.online) { %><span class="chat-state-dot s-online" title="<%= t.getProperty("chat.status.online") %>"></span><% } %>
        </span>
        <% if (p.pub) { %><a class="people-name" href="/hrac/<%= urlName %>"><%= WebUtils.escapeHtml(p.username) %></a><% } else { %><span class="people-name"><%= WebUtils.escapeHtml(p.username) %></span><% } %>
        <% if ("friends".equals(p.rel)) { %>
          <a class="btn-outline friend-btn" href="/zpravy?s=<%= urlName %>"><i class="fa-solid fa-comments" aria-hidden="true"></i> <%= t.getProperty("people.write") %></a>
        <% } else { String act = "sent".equals(p.rel) ? "cancel" : "received".equals(p.rel) ? "accept" : "request"; %>
          <form method="post" action="/profile/friends">
            <input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(p.username) %>">
            <input type="hidden" name="action" value="<%= act %>"><input type="hidden" name="back" value="<%= WebUtils.escapeHtml(frFindBack) %>">
            <button type="submit" class="<%= "sent".equals(p.rel) ? "btn-outline" : "btn-primary" %> friend-btn"><%= t.getProperty("sent".equals(p.rel) ? "friends.cancel" : "received".equals(p.rel) ? "friends.accept" : "friends.add") %></button>
          </form>
        <% } %>
      </li>
      <% } %>
    </ul>
    <% if (frPage > 0 || frPeopleMore) { %>
    <nav class="people-pager">
      <% if (frPage > 0) { %><a class="btn-outline" href="/uzivatel.jsp?najit=1&amp;np=<%= frPage - 1 %>#pratele"><%= t.getProperty("people.prev") %></a><% } %>
      <% if (frPeopleMore) { %><a class="btn-outline" href="/uzivatel.jsp?najit=1&amp;np=<%= frPage + 1 %>#pratele"><%= t.getProperty("people.next") %></a><% } %>
    </nav>
    <% } %>
    </div>
    </details>

    <% if (!frIn.isEmpty()) { %>
    <h4 class="friend-head"><%= t.getProperty("friends.requests") %> <span class="acct-count"><%= frIn.size() %></span></h4>
    <ul class="friend-list">
      <% for (Friend f : frIn) { %>
      <li class="friend-row">
        <%= frWho(f) %>
        <form method="post" action="/profile/friends"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="accept"><button type="submit" class="btn-primary friend-btn"><%= t.getProperty("friends.accept") %></button></form>
        <form method="post" action="/profile/friends"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="decline"><button type="submit" class="btn-outline friend-btn"><%= t.getProperty("friends.decline") %></button></form>
        <form method="post" action="/profile/friends" onsubmit="return confirm('<%= WebUtils.escapeJs(t.getProperty("friends.blockConfirm")) %>');"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="block"><button type="submit" class="btn-outline friend-btn"><%= t.getProperty("friends.block") %></button></form>
      </li>
      <% } %>
    </ul>
    <% } %>

    <h4 class="friend-head"><%= t.getProperty("friends.mine") %> <span class="acct-count"><%= frFriends.size() %></span></h4>
    <% if (frFriends.isEmpty()) { %><p class="acct-empty"><%= t.getProperty("friends.none") %></p><% } %>
    <ul class="friend-list">
      <% for (Friend f : frFriends) { %>
      <li class="friend-row">
        <%= frWho(f) %>
        <a class="btn-primary friend-btn friend-write" href="/zpravy?s=<%= java.net.URLEncoder.encode(f.username, "UTF-8") %>"><i class="fa-solid fa-comments" aria-hidden="true"></i> <%= t.getProperty("chat.write") %></a>
        <form method="post" action="/profile/friends" onsubmit="return confirm('<%= WebUtils.escapeJs(t.getProperty("friends.removeConfirm")) %>');"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="remove"><button type="submit" class="btn-outline friend-btn"><%= t.getProperty("friends.remove") %></button></form>
      </li>
      <% } %>
    </ul>

    <% if (!frOut.isEmpty()) { %>
    <details class="acct-more"><summary><%= t.getProperty("friends.sent") %> (<%= frOut.size() %>)</summary>
    <ul class="friend-list">
      <% for (Friend f : frOut) { %>
      <li class="friend-row">
        <%= frWho(f) %>
        <form method="post" action="/profile/friends"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="cancel"><button type="submit" class="btn-outline friend-btn"><%= t.getProperty("friends.cancel") %></button></form>
      </li>
      <% } %>
    </ul>
    </details>
    <% } %>
    <% if (!frBlocked.isEmpty()) { %>
    <details class="acct-more"><summary><%= t.getProperty("friends.blocked") %> (<%= frBlocked.size() %>)</summary>
    <ul class="friend-list">
      <% for (Friend f : frBlocked) { %>
      <li class="friend-row">
        <%= frWho(f) %>
        <form method="post" action="/profile/friends"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="name" value="<%= WebUtils.escapeHtml(f.username) %>"><input type="hidden" name="action" value="unblock"><button type="submit" class="btn-outline friend-btn"><%= t.getProperty("friends.unblock") %></button></form>
      </li>
      <% } %>
    </ul>
    </details>
    <% } %>
  </div>
</section>
