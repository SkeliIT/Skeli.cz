<%-- Vitrína: až 3 odznaky, kterými se člověk chlubí (ze hry i z webu). Předem nastavit shownBadges (List<String>) a shownEarned (Set<String>, všechny získané).
     Ukazují se jen získané, kdyby o některý přišel. Vkládaná šablona se nečte jako UTF-8: žádné české znaky přímo ve výstupu. --%>
<% boolean anyShown = false; for (String shownKey : shownBadges) anyShown |= shownEarned.contains(shownKey); %>
<% if (anyShown) { %>
<ul class="pt-show" aria-label="<%= t.getProperty("vis.showcase.title") %>">
  <% for (String shownKey : shownBadges) { if (!shownEarned.contains(shownKey)) continue; %>
  <li class="pt-show-item" data-rar="<%= com.github.skeliit.model.SiteBadges.rarity(shownKey) %>"><i class="fa-solid <%= com.github.skeliit.model.SiteBadges.icon(shownKey) %>" aria-hidden="true"></i> <span><%= t.getProperty(com.github.skeliit.model.SiteBadges.nameKey(shownKey)) %></span></li>
  <% } %>
</ul>
<% } %>
